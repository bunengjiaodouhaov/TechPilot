APP_ENV=development

DATABASE_URL=postgresql+asyncpg://techpilot:techpilot@localhost:5432/techpilot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Authentication. Change the signing secret outside local development.
AUTH_SECRET_KEY=dev-only-change-me
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_DEMO_ENABLED=true

# Dense retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Hybrid retrieval and reranking
BM25_K1=1.5
BM25_B=0.75
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
ANSWER_RETRIEVAL_CANDIDATE_LIMIT=40
ANSWER_RERANK_DEPTH=20
ANSWER_RRF_K=60

# Verifier-driven second-chance evidence recovery. Recovery is attempted only
# after a first-pass INSUFFICIENT verifier result; CONFLICTING stays fail-closed.
ANSWER_RECOVERY_ENABLED=true
ANSWER_RECOVERY_ANCHOR_LIMIT=20
ANSWER_RECOVERY_PARENT_GROUP_LIMIT=2
ANSWER_RECOVERY_MAX_ADDITIONS=12

# LLM
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
ANSWER_CONTEXT_MAX_CHARACTERS=12000
